# Hardening fragment for the agent guest kernel.
# Merge onto Firecracker's recommended microVM guest config
# (resources/guest_configs in the firecracker repository), e.g. with
#   scripts/kconfig/merge_config.sh base.config guest-kernel.config
#
# Goal: even if a network card were attached by mistake, the guest kernel
# would have no IP stack to use it with. vsock is the only socket family left.
# UNTESTED in this repository: confirm the guest boots and the runner connects.

# Needed for vsock and Unix sockets
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y

# No IP networking of any kind
# CONFIG_INET is not set
# CONFIG_IPV6 is not set
# CONFIG_PACKET is not set
# CONFIG_VIRTIO_NET is not set
# CONFIG_NETFILTER is not set
# CONFIG_WIRELESS is not set
# CONFIG_BT is not set

# No loadable modules: the kernel you ship is the kernel that runs
# CONFIG_MODULES is not set

# Devices the VM does need
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_EXT4_FS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
