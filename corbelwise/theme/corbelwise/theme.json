				{
					"slug": "surface",
					"name": "Surface",
					"color": "#F2EFE9"
				},
				{
					"slug": "contrast",
					"name": "Contrast",
					"color": "#16150F"
				},
				{
					"slug": "muted",
					"name": "Muted text",
					"color": "#5C5950"
				},
				{
					"slug": "accent",
					"name": "Accent",
					"color": "#22408F"
				},
				{
					"slug": "accent-strong",
