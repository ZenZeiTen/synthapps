{
  "name": "retroglot",
  "version": "0.1.0",
  "description": "Play retro games from DOS to the PS1 era in the browser, with live on-screen translation by Claude.",
  "type": "module",
  "license": "MIT",
  "bin": { "retroglot": "bin/retroglot.js" },
  "engines": { "node": ">=20" },
  "scripts": {
    "setup": "node bin/retroglot.js install-runtime",
    "start": "node bin/retroglot.js start",
    "test": "node --test \"test/unit/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 \"test/e2e/*.test.js\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0"
  }
}
