{
  "name": "nalara",
  "version": "0.1.0",
  "private": true,
  "description": "An AI-native operating system where Claude is the kernel: intent in, agent swarm and workspace out, on a graph canvas.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "nalara": "./bin/nalara.js"
  },
  "scripts": {
    "dev": "node --import tsx src/cli.ts serve --dev",
    "start": "node --import tsx src/cli.ts serve",
    "cli": "node --import tsx src/cli.ts",
    "build": "vite build --config web/vite.config.ts",
    "build:app": "node --import tsx scripts/build-app.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "node --import tsx test/e2e/run.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@xyflow/react": "^12.12.0",
    "ajv": "^8.20.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright-core": "^1.63.0",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
