{
  "name": "lintas-browser",
  "version": "0.4.0",
  "description": "Lintas: a fast, secure, AI-powered web browser that works online and offline, with a built-in Translation Management System.",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "test:app": "node test/app.smoke.mjs",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "build:preload": "node scripts/build-preload.mjs",
    "prestart": "node scripts/build-preload.mjs",
    "predist": "node scripts/build-preload.mjs",
    "mcp": "node app/mcp/server.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "electron-chrome-extensions": "^4.10.0",
    "electron-chrome-web-store": "^0.13.0"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "productName": "Lintas",
  "main": "app/main/main.js",
  "author": {
    "name": "ZenZeiTen"
  },
  "homepage": "https://github.com/ZenZeiTen/synthapps/tree/main/lintas",
  "build": {
    "appId": "com.zenzeiten.lintas",
    "productName": "Lintas",
    "copyright": "Copyright © 2026 ZenZeiTen",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "app/**",
      "samples/**",
      "core/**",
      "package.json",
      "LICENSE",
      "!**/*.md"
    ],
    "asar": true,
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network;WebBrowser",
      "executableName": "lintas",
      "maintainer": "ZenZeiTen <https://github.com/ZenZeiTen/synthapps>",
      "synopsis": "AI-powered online/offline browser with a Translation Management System"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lintas",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "Lintas",
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Lintas-Setup-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "protocols": [
      {
        "name": "Web page",
        "schemes": [
          "http",
          "https"
        ]
      }
    ],
    "portable": {
      "artifactName": "Lintas-Portable-${version}-${arch}.${ext}"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ZenZeiTen/synthapps.git",
    "directory": "lintas"
  },
  "desktopName": "lintas.desktop"
}
