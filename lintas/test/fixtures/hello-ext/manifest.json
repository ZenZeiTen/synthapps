{
  "manifest_version": 3,
  "name": "Lintas test extension",
  "version": "1.0.0",
  "description": "Adds a paragraph to every page; used by the end-to-end test.",
  "action": {
    "default_title": "Lintas test",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icon.png"
  },
  "background": {
    "service_worker": "sw.js"
  },
  "permissions": [
    "identity",
    "pageCapture",
    "userScripts",
    "contextMenus",
    "debugger",
    "sidePanel",
    "offscreen",
    "alarms",
    "tabGroups",
    "scripting",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "side_panel": {
    "default_path": "panel.html"
  },
  "commands": {
    "lintas-test": {
      "suggested_key": {
        "default": "Alt+Shift+Y"
      },
      "description": "Marks the page (end-to-end test)"
    }
  },
  "key": ""
}
