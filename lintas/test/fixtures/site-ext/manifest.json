{
  "manifest_version": 3,
  "name": "Lintas site test",
  "version": "1.0",
  "description": "Marks pages it runs on (site access test).",
  "key": "",
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "mark.js"
      ],
      "run_at": "document_start"
    }
  ]
}