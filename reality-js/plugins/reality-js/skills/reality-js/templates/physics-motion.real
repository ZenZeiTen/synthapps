# Real motion: a dropped ball, a spring, a pendulum and a hand-held camera,
# all closed-form functions of t, so motion blur is exact.

timeline { duration: 4s, fps: 24, time: 0.6s }

camera {
  position: [0, 1.3, 6] + wobble(t, 2cm, 0.6)   # hand-held sway
  look_at: [0, 1, 0]
  lens: 35mm
  aperture: f/4
  shutter: 1/48s                               # 180° at 24 fps: film motion blur
}

sky { sun_elevation: 45, sun_azimuth: 150 }
render { samples: 256, video_samples: 64 }

ground { material: matte { color: gray(0.55), pattern: grid, color2: gray(0.4), pattern_scale: 1 } }

# Dropped from 2 m, keeping 70% of its speed each bounce, released at 0.2 s.
sphere { position: [-1.6, 0.25 + bounce(t, 2m, 0.7, 0.2), 0], radius: 0.25, material: plastic { color: #e04b3a } }

# Springs from 0.3 m to 1.5 m up, 1.2 Hz, damping 0.25 (visible overshoot).
box { position: [0, spring(t, 0.3, 1.5, 1.2, 0.25), 0], size: 0.4, material: plastic { color: #2f7fd6 } }

# A 1.4 m pendulum swinging ±35°, hung at [1.8, 2.4, 0].
group {
  position: [1.8, 2.4, 0]
  rotate: [0, 0, pendulum(t, 1.4, 35)]
  cylinder { position: [0, -0.7, 0], radius: 0.01, height: 1.4, material: metal { color: chrome } }
  sphere { position: [0, -1.5, 0], radius: 0.14, material: metal { color: brass, roughness: 0.2 } }
}
