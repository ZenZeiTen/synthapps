# Interior with sunbeams: a closed room lit only through one window, with
# dusty air. The fog makes the beams visible; forward scattering
# (anisotropy) makes them glow because the camera looks toward the sun.
# Volumetric light is noisy: finals need 512 to 1024 samples.

camera { position: [1.4, 1.5, 3.8], look_at: [-0.3, 1.2, -3], lens: 24mm }

sky { sun_elevation: 25, sun_azimuth: 20 }   # outside the back wall, slightly right
fog { density: 0.06, anisotropy: 0.7, height: 3.2m, color: #f2ece2 }
film { bloom: 0.05, grain: 0.1 }
render { samples: 1024, bounces: 8 }

let wall = matte { color: #d9d2c5 }

ground { material: matte { color: #8a6a4a, pattern: wood, color2: #6e5238, pattern_scale: 1.2 } }
box { position: [0, 3.3, 0.5], size: [8.4, 0.2, 9.4], material: wall }    # ceiling
box { position: [-4.1, 1.6, 0.5], size: [0.2, 3.2, 9.4], material: wall }  # left
box { position: [4.1, 1.6, 0.5], size: [0.2, 3.2, 9.4], material: wall }   # right
box { position: [0, 1.6, 5.1], size: [8.4, 3.2, 0.2], material: wall }     # behind the camera

# Back wall with a window 2 m wide, from 1 m to 2.4 m high, and a cross bar.
box { position: [-2.55, 1.6, -4.1], size: [3.1, 3.2, 0.2], material: wall }
box { position: [2.55, 1.6, -4.1], size: [3.1, 3.2, 0.2], material: wall }
box { position: [0, 0.5, -4.1], size: [2, 1, 0.2], material: wall }
box { position: [0, 2.8, -4.1], size: [2, 0.8, 0.2], material: wall }
box { position: [0, 1.7, -4.1], size: [0.06, 1.4, 0.12], material: matte { color: #3b2f25 } }
box { position: [0, 1.7, -4.1], size: [2, 0.06, 0.12], material: matte { color: #3b2f25 } }

box { position: [-1.6, 0.4, -1.4], size: [1.2, 0.8, 0.7], rotate: [0, 15, 0], material: plastic { color: #2f5d8a, roughness: 0.4 } }
sphere { position: [0.9, 0.35, -0.6], radius: 0.35, material: metal { color: copper, roughness: 0.3 } }
