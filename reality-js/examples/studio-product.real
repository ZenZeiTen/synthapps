# Product shot: studio HDRI lighting, a vase from an .obj file, a tiled
# floor from a texture, and a telephoto lens.

camera {
  position: [0, 0.34, 2.1]
  look_at: [0, 0.2, 0]
  lens: 85mm
  aperture: f/4
}

hdri { src: "assets/studio.hdr", rotate: 20 }

film { bloom: 0.03, vignette: 0.6 }

ground { material: material { texture: "assets/tiles.png", texture_scale: 1.5, roughness: 0.12 } }

mesh { src: "assets/vase.obj", material: plastic { color: #f2eee6, roughness: 0.18, clearcoat: 0.6 } }

sphere { position: [0.24, 0.07, 0.12], radius: 0.07, material: glass { tint: #ffb870, tint_distance: 0.08 } }
sphere { position: [-0.23, 0.05, 0.16], radius: 0.05, material: metal { color: brass, roughness: 0.28 } }
